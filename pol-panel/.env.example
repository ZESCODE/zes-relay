# ── Panel sidecar ─────────────────────────────────────────────────────────────
# Port the Node sidecar (API + built assets) listens on.
PANEL_PORT=7178
# Bind address. 127.0.0.1 by default; the panel REFUSES 0.0.0.0 unless
# PANEL_ALLOW_PUBLIC=true is also set.
PANEL_HOST=127.0.0.1
# Set to true to allow binding to 0.0.0.0 (needed to reach the panel from another
# device on the LAN, e.g. a phone browsing a Termux host).
PANEL_ALLOW_PUBLIC=false
# Vite dev server port (npm run dev only).
PANEL_DEV_PORT=7177

# ── Auth ──────────────────────────────────────────────────────────────────────
# Admin credentials created on first run. If unset, a one-time password is
# generated, written to data/FIRST-RUN.txt (mode 0600) and printed to stderr.
PANEL_ADMIN_USER=admin
# PANEL_ADMIN_PASSWORD=
# Session lifetime in hours.
PANEL_SESSION_HOURS=72
# Chat rate limit: requests per minute per session/IP.
PANEL_CHAT_RPM=30
# Login rate limit: attempts per minute per IP.
PANEL_LOGIN_RPM=5

# ── Relay child process ───────────────────────────────────────────────────────
# Defaults are resolved relative to the repository root (the panel's parent dir).
POL_RELAY_PORT=7179
POL_RELAY_SCRIPT=pol_relay.py
POL_RELAY_CWD=
PYTHON_BIN=python3
# Adopt a relay already listening on POL_RELAY_PORT instead of spawning one.
PANEL_ADOPT_EXTERNAL=true

# ── Relay configuration (written to data/.env by the Config page) ─────────────
POL_UPSTREAM_BASE=https://gen.pollinations.ai/v1
POL_API_KEY=
POL_SKIP_AUTH=true
POL_DATA_DIR=
POL_MODEL_CACHE_TTL=60
POL_UPSTREAM_TIMEOUT=600
